{
  "name": "udhaar \u2014 the little things between us",
  "short_name": "udhaar",
  "description": "The cab, the split, the 'I'll send it later.' Keep your shared tabs together, without searching the group chat.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#F6F3EC",
  "theme_color": "#F6F3EC",
  "categories": [
    "finance",
    "social",
    "lifestyle"
  ],
  "lang": "en-IN",
  "dir": "ltr",
  "shortcuts": [
    {
      "name": "Log something",
      "short_name": "Log",
      "description": "Write a new line in the ledger",
      "url": "/#/add",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "My ledger",
      "short_name": "Ledger",
      "url": "/#/",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "My account",
      "short_name": "Account",
      "url": "/#/you",
      "icons": [
        {
          "src": "/icons/icon-512.png",
          "sizes": "512x512"
        }
      ]
    }
  ],
  "icons": [
